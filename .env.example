# Copie este arquivo para .env antes de subir a infraestrutura local:
#   cp .env.example .env
#
# O arquivo .env NAO deve ser versionado.
# Estes valores servem apenas para desenvolvimento local. Nao use credenciais reais aqui.

# ---------------------------------------------------------------------------
# PostgreSQL local (docker compose)
# ---------------------------------------------------------------------------
POSTGRES_DB=prisma_rh
POSTGRES_USER=prisma_rh
POSTGRES_PASSWORD=prisma_rh_dev

# Porta exposta no host. O padrao e 5433 (e nao 5432) para nao conflitar com
# uma instalacao nativa de PostgreSQL que ja esteja ocupando a 5432.
POSTGRES_PORT=5433

# ---------------------------------------------------------------------------
# Dados de demonstracao (somente Development)
# ---------------------------------------------------------------------------
# Senha dos usuarios ficticios criados na primeira execucao do backend.
# Se ficar vazia, a semeadura nao roda e nao ha com quem entrar.
# NAO ha senha no codigo: ela vem daqui.
PRISMARH_SEED_SENHA=troque-esta-senha-de-demonstracao

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# O backend le a string de conexao de backend/src/PrismaRH.Api/appsettings.Development.json,
# que ja vem preenchido com os valores acima. Se voce alterar qualquer valor desta secao,
# ajuste tambem aquele arquivo ou defina a variavel de ambiente abaixo, que tem
# prioridade sobre o appsettings:
#
# ConnectionStrings__PrismaRh=Host=localhost;Port=5433;Database=prisma_rh;Username=prisma_rh;Password=prisma_rh_dev

# ---------------------------------------------------------------------------
# Autenticacao (JWT)
# ---------------------------------------------------------------------------
# Em Development a chave vem de appsettings.Development.json.
# FORA de Development ela e obrigatoria e precisa vir daqui, com 32+ caracteres:
#
# Jwt__ChaveAssinatura=troque-por-uma-chave-longa-e-aleatoria-de-verdade
